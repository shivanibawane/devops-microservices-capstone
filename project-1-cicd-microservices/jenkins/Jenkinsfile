pipeline {
    agent any

    environment {
        REGISTRY = 'docker.io'
        REGISTRY_CREDENTIAL_ID = 'dockerhub-credentials'
        DOCKER_IMAGE_REPO = 'devopsstudent/capstone-store'
        IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
        SONAR_SCANNER_HOME = tool 'SonarQubeScanner'
        SONAR_SERVER_NAME = 'SonarQubeServer'
        SLACK_CHANNEL = '#devops-deployments'
        ANSIBLE_VAULT_PASSWORD_ID = 'ansible-vault-secret'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('1. Checkout SCM') {
            steps {
                echo "Checking out code from Git..."
                checkout scm
                script {
                    echo "Branch: ${env.BRANCH_NAME ?: 'main'}"
                    echo "Commit: ${env.GIT_COMMIT}"
                }
            }
        }

        stage('2. Build & Unit Tests') {
            parallel {
                stage('Test Frontend') {
                    steps {
                        dir('project-1-cicd-microservices/app/frontend') {
                            sh '''
                                echo "Running frontend tests..."
                                npm install --silent
                                npm test
                            '''
                        }
                    }
                }
                stage('Test Products Service') {
                    steps {
                        dir('project-1-cicd-microservices/app/products-service') {
                            sh '''
                                echo "Running products service tests..."
                                python3 -m venv venv
                                . venv/bin/activate
                                pip install --quiet -r requirements.txt
                                pytest test_app.py
                            '''
                        }
                    }
                }
                stage('Test Cart Service') {
                    steps {
                        dir('project-1-cicd-microservices/app/cart-service') {
                            sh '''
                                echo "Running cart service tests..."
                                npm install --silent
                                npm test
                            '''
                        }
                    }
                }
            }
        }

        stage('3. Code Analysis (SonarQube Gate)') {
            steps {
                withSonarQubeEnv(SONAR_SERVER_NAME) {
                    sh """
                        ${SONAR_SCANNER_HOME}/bin/sonar-scanner \
                            -Dsonar.projectKey=capstone-microservices \
                            -Dsonar.projectName="DevOps Capstone Store" \
                            -Dsonar.sources=project-1-cicd-microservices/app \
                            -Dsonar.exclusions=**/node_modules/**,**/venv/**
                    """
                }
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        // Quality Gate 1: Fail build if SonarQube quality gate fails
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to Quality Gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('4. Package Images (Docker Build)') {
            steps {
                dir('project-1-cicd-microservices/app') {
                    sh """
                        echo "Building container images tagged with ${IMAGE_TAG} and latest..."
                        docker build -t ${DOCKER_IMAGE_REPO}-frontend:${IMAGE_TAG} -t ${DOCKER_IMAGE_REPO}-frontend:latest ./frontend
                        docker build -t ${DOCKER_IMAGE_REPO}-products:${IMAGE_TAG} -t ${DOCKER_IMAGE_REPO}-products:latest ./products-service
                        docker build -t ${DOCKER_IMAGE_REPO}-cart:${IMAGE_TAG} -t ${DOCKER_IMAGE_REPO}-cart:latest ./cart-service
                    """
                }
            }
        }

        stage('5. Security Scan (Trivy Gate)') {
            steps {
                script {
                    echo "Quality Gate 2: Scanning images with Trivy..."
                    def images = [
                        "${DOCKER_IMAGE_REPO}-frontend:${IMAGE_TAG}",
                        "${DOCKER_IMAGE_REPO}-products:${IMAGE_TAG}",
                        "${DOCKER_IMAGE_REPO}-cart:${IMAGE_TAG}"
                    ]
                    for (img in images) {
                        sh """
                            echo "Scanning ${img}..."
                            trivy image --exit-code 0 --severity HIGH ${img}
                            # Fail the pipeline if any CRITICAL vulnerabilities are found
                            trivy image --exit-code 1 --severity CRITICAL ${img}
                        """
                    }
                }
            }
        }

        stage('6. Push Images to Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: REGISTRY_CREDENTIAL_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    sh """
                        echo "${REG_PASS}" | docker login -u "${REG_USER}" --password-stdin ${REGISTRY}
                        docker push ${DOCKER_IMAGE_REPO}-frontend:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE_REPO}-frontend:latest
                        docker push ${DOCKER_IMAGE_REPO}-products:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE_REPO}-products:latest
                        docker push ${DOCKER_IMAGE_REPO}-cart:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE_REPO}-cart:latest
                    """
                }
            }
        }

        stage('7. Deploy to Dev & Staging') {
            steps {
                dir('project-1-cicd-microservices/ansible') {
                    withCredentials([string(credentialsId: ANSIBLE_VAULT_PASSWORD_ID, variable: 'VAULT_PASS')]) {
                        sh """
                            echo "Deploying to DEV..."
                            ansible-playbook -i inventories/dev.ini deploy.yml \
                                -e "image_tag=${IMAGE_TAG} docker_repo=${DOCKER_IMAGE_REPO}" \
                                --vault-password-file <(echo "${VAULT_PASS}")

                            echo "Deploying to STAGING..."
                            ansible-playbook -i inventories/staging.ini deploy.yml \
                                -e "image_tag=${IMAGE_TAG} docker_repo=${DOCKER_IMAGE_REPO}" \
                                --vault-password-file <(echo "${VAULT_PASS}")
                        """
                    }
                }
            }
        }

        stage('8. Manual Production Approval') {
            steps {
                // Quality Gate 3: Human sign-off before production release
                timeout(time: 24, unit: 'HOURS') {
                    input message: "Approve deployment of version ${IMAGE_TAG} to PRODUCTION?",
                          ok: "Deploy to Prod",
                          submitter: "admin,lead-devops,release-manager"
                }
            }
        }

        stage('9. Deploy to Production') {
            steps {
                dir('project-1-cicd-microservices/ansible') {
                    withCredentials([string(credentialsId: ANSIBLE_VAULT_PASSWORD_ID, variable: 'VAULT_PASS')]) {
                        sh """
                            echo "Deploying version ${IMAGE_TAG} to PRODUCTION..."
                            ansible-playbook -i inventories/production.ini deploy.yml \
                                -e "image_tag=${IMAGE_TAG} docker_repo=${DOCKER_IMAGE_REPO}" \
                                --vault-password-file <(echo "${VAULT_PASS}")
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs deleteDirs: true, notFailBuild: true
        }
        success {
            echo "Pipeline succeeded! Notifying Slack/Email..."
            // slackSend channel: SLACK_CHANNEL, color: '#36a64f', message: "SUCCESSFUL DEPLOYMENT: Build #${env.BUILD_NUMBER} (${IMAGE_TAG}) deployed to Production."
        }
        failure {
            echo "Pipeline failed! Notifying on-call team..."
            // slackSend channel: SLACK_CHANNEL, color: '#dc3545', message: "PIPELINE FAILED: Build #${env.BUILD_NUMBER} failed at stage: ${env.STAGE_NAME}. Immediate attention required."
        }
    }
}
