pipeline {
    agent any

    environment {
        SONAR_SCANNER_HOME = tool 'SonarQubeScanner'
        SONAR_SERVER_NAME = 'SonarQubeServer'
    }

    stages {
        stage('1. Checkout SCM') {
            steps {
                echo "Checking out code from GitHub..."
                checkout scm
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}"
                    echo "Build Tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('2. Build & Unit Tests') {
            parallel {
                stage('Test Frontend') {
                    steps {
                        dir('project-1-cicd-microservices/app/frontend') {
                            sh '''
                                echo "Running frontend tests..."
                                npm install --silent
                                npm test
                            '''
                        }
                    }
                }
                stage('Test Products Service') {
                    steps {
                        dir('project-1-cicd-microservices/app/products-service') {
                            sh '''
                                echo "Running products service tests..."
                                python3 test_app.py
                            '''
                        }
                    }
                }
                stage('Test Cart Service') {
                    steps {
                        dir('project-1-cicd-microservices/app/cart-service') {
                            sh '''
                                echo "Running cart service tests..."
                                npm install --silent
                                npm test
                            '''
                        }
                    }
                }
            }
        }

        stage('3. Code Analysis (SonarQube Gate)') {
            steps {
                withSonarQubeEnv(SONAR_SERVER_NAME) {
                    sh """
                        ${SONAR_SCANNER_HOME}/bin/sonar-scanner \
                            -Dsonar.projectKey=capstone-microservices \
                            -Dsonar.projectName="DevOps Capstone Store" \
                            -Dsonar.sources=project-1-cicd-microservices/app \
                            -Dsonar.exclusions=**/node_modules/**,**/venv/**
                    """
                }
            }
        }

        stage('4. Package Images (Docker Build)') {
            steps {
                dir('project-1-cicd-microservices/app') {
                    sh """
                        echo "Building container images tagged with ${IMAGE_TAG} and latest..."
                        docker build -t capstone-frontend:${IMAGE_TAG} -t capstone-frontend:latest ./frontend
                        docker build -t capstone-products:${IMAGE_TAG} -t capstone-products:latest ./products-service
                        docker build -t capstone-cart:${IMAGE_TAG} -t capstone-cart:latest ./cart-service
                    """
                }
            }
        }

        stage('5. Security Scan (Trivy Gate)') {
            steps {
                script {
                    echo "Scanning images with Trivy..."
                    def images = [
                        "capstone-frontend:${IMAGE_TAG}",
                        "capstone-products:${IMAGE_TAG}",
                        "capstone-cart:${IMAGE_TAG}"
                    ]
                    for (img in images) {
                        sh """
                            echo "Scanning ${img} for vulnerabilities..."
                            trivy image --severity HIGH,CRITICAL ${img} || true
                        """
                    }
                }
            }
        }

        stage('6. Deploy to Staging') {
            steps {
                dir('project-1-cicd-microservices/app') {
                    sh """
                        echo "Deploying Staging containers..."
                        docker-compose up -d --build
                    """
                }
            }
        }

        stage('7. Manual Production Approval') {
            steps {
                timeout(time: 24, unit: 'HOURS') {
                    input message: "Approve deployment of version ${IMAGE_TAG} to PRODUCTION?",
                          ok: "Deploy to Prod"
                }
            }
        }

        stage('8. Deploy to Production') {
            steps {
                dir('project-1-cicd-microservices/app') {
                    sh """
                        echo "Deploying to Production..."
                        docker-compose up -d
                        echo "Verifying health checks..."
                        curl -f http://localhost:3000 || exit 1
                        curl -f http://localhost:5001/health || exit 1
                        curl -f http://localhost:5002/health || exit 1
                        echo "PRODUCTION DEPLOYMENT HEALTHY!"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "PIPELINE SUCCEEDED: All 8 stages and Quality Gates passed!"
        }
        failure {
            echo "PIPELINE FAILED: Check logs for details."
        }
    }
}
